# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
# Neon project link (org/project/branch IDs only, no secrets) - committed on purpose
# so `neon` commands and teammates resolve the project automatically after clone.
# (.neon is intentionally absent from this file)

# Download cache (public source files; do not commit full pages or contact lists)
/data/candidates/raw/
/data/candidates/policy-source-sections.json
/data/candidates/schema-extension.txt
/data/candidates/candidate-photo-progress.json
/scripts/__pycache__/

# Worktrees other sessions check out inside the repo. Each is a second working
# tree with its own .git file, so it is never repo content.
/.claude/worktrees/
