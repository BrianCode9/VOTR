DATABASE_URL=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=

# Optional. Minimum extractor confidence before a stance change earns the
# FLIP_FLOP badge. Defaults to 0.7. A false flip-flop accusation is the most
# damaging thing this app can print, so raise this rather than lower it.
FLIP_FLOP_CONFIDENCE_THRESHOLD=

# Optional. The model used for the plain-language rewrite pass.
# Defaults to claude-opus-5.
REWRITE_MODEL=

# Optional. Cut points for confidence_label, which decides whether a card is
# presented as something the person said (`stated`) or as something to go and
# check (`nudge_verify`). Default 0.8 and 0.5. Both must be in [0, 1] and
# medium must not exceed high, or the pair is ignored and the defaults stand.
# Moving CONFIDENCE_MEDIUM_THRESHOLD changes how cards are WORDED, not just
# how they are sorted.
CONFIDENCE_HIGH_THRESHOLD=
CONFIDENCE_MEDIUM_THRESHOLD=

# Optional. How alike two insights must be before they count as the same claim
# reported by two outlets. Defaults 0.82 (edit-distance ratio) and 0.6 (content
# word overlap); either one matching is enough. Raise them if the
# source-diversity counts look generous; lowering them inflates a number
# readers use to decide how much to trust a card.
CORROBORATION_TEXT_SIMILARITY=
CORROBORATION_TOKEN_OVERLAP=

# Optional. Enables POST /api/v1/dev/seed in production. Off by default, and
# outside production the endpoint is on without this. The demo fixtures are
# synthetic documents attributed to invented people; nothing that ships to
# real users should be able to create them.
ALLOW_DEMO_SEED=
